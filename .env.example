# Servidor
PORT=3000

# MongoDB
MONGO_URI=mongodb://mongo:27017/catalogobulk

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Auth (JWT)
JWT_SECRET=cambiar_en_produccion
JWT_EXPIRES_IN=1h

# Uploads / Importación
MAX_FILE_SIZE_MB=50
BATCH_SIZE=500

# Caché
CACHE_TTL_SECONDS=300

# Límite de errores por importación
IMPORT_ERRORS_CAP=1000
